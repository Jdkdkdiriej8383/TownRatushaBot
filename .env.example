# Telegram Bot
BOT_TOKEN=123456789:AABBCCDDEEFFggHHiiJJKKllMMnnOOppQQ
MAIN_CHAT_ID=-1001234567890
LOG_CHAT_ID=-1009876543210

# Database
# Для PostgreSQL: postgresql+asyncpg://user:password@host:5432/towndb
# Примечание для Render/Neon/Supabase: можно вставлять напрямую URL с postgres:// или postgresql:// - бот сам преобразует в asyncpg.
# Для локального тестирования (SQLite): sqlite+aiosqlite:///townbot.db
DATABASE_URL=postgresql+asyncpg://town_user:town_pass@localhost:5432/towndb
DB_ECHO=false

# Cross-bot API (Intercom)
API_HOST=0.0.0.0
# На Render хостинге порт передается автоматически через переменную PORT
API_PORT=8000
INTERCOM_SECRET_TOKEN=town_cross_bot_secret_token_change_me
POLL_BOT_API_URL=http://localhost:8001/api/v1

# Fine system
FINE_EXPIRATION_HOURS=48
FINE_DOUBLE_MULTIPLIER=2.0
