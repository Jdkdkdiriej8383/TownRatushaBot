# Telegram Bot
BOT_TOKEN=123456789:AABBCCDDEEFFggHHiiJJKKllMMnnOOppQQ
MAIN_CHAT_ID=-1001234567890
LOG_CHAT_ID=-1009876543210

# Database (Supabase / PostgreSQL)
# Для Supabase: скопируйте Connection String (URI) из Dashboard -> Project Settings -> Database.
# Рекомендуется режим Connection Pooler (порт 6543 или 5432):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Примечание: бот автоматически преобразует postgresql:// в postgresql+asyncpg:// и адаптирует sslmode=require.
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_ECHO=false

# Cross-bot API (Intercom)
API_HOST=0.0.0.0
# На Render хостинге порт передается автоматически через переменную PORT
API_PORT=8000
INTERCOM_SECRET_TOKEN=town_cross_bot_secret_token_change_me
POLL_BOT_API_URL=http://localhost:8001/api/v1

# Fine system
FINE_EXPIRATION_HOURS=48
FINE_DOUBLE_MULTIPLIER=2.0
